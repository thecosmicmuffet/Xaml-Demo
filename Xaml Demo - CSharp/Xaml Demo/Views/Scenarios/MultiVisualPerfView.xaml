<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Xaml_Demo.ViewModels"
             xmlns:svc="clr-namespace:Xaml_Demo.Services"
             xmlns:sel="clr-namespace:Xaml_Demo.Views.Selectors"
             xmlns:ctrl="clr-namespace:Xaml_Demo.Controls"
             x:Class="Xaml_Demo.Views.Scenarios.MultiVisualPerfView"
             x:DataType="vm:MultiVisualPerfViewModel"
             Loaded="OnLoaded"
             BindingContext="{StaticResource MultiVisualPerfViewModel}">
  <ContentView.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="PerfItemTemplate"
                    x:DataType="vm:PerfItemViewModel">
        <Grid ColumnDefinitions="40,*"
              Padding="2"
              svc:FirstBindTracker.Enable="True">
          <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped"
                CommandParameter="{Binding .}"/>
          </Grid.GestureRecognizers>
          <BoxView Color="{Binding Color}"
                   CornerRadius="4"/>
          <Label Grid.Column="1"
                 Text="{Binding ColorString}"
                 FontSize="12"
                 VerticalTextAlignment="Center"/>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="PerfItemTemplateSelected"
                    x:DataType="vm:PerfItemViewModel">
        <Border Padding="8"
                Stroke="{DynamicResource Primary}"
                StrokeThickness="1">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped"
                CommandParameter="{Binding .}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="40,*"
                Padding="2"
                svc:FirstBindTracker.Enable="True">
            <BoxView Color="{Binding Color}"
                     CornerRadius="4"/>
            <Label Grid.Column="1"
                   Text="{Binding ColorString}"
                   FontSize="12"
                   VerticalTextAlignment="Center"/>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Template selector leveraging selection context (the view model) -->
      <sel:PerfItemSelectionTemplateSelector x:Key="PerfItemTemplateSelector"
                                             PerfItemTemplate="{StaticResource PerfItemTemplate}"
                                             PerfItemTemplateSelected="{StaticResource PerfItemTemplateSelected}"
                                             SelectionContext="{StaticResource MultiVisualPerfViewModel}"/>
    </ResourceDictionary>
  </ContentView.Resources>
  <VisualStateManager.VisualStateGroups>
    <VisualStateGroupList>
      <VisualStateGroup x:Name="ColorStates">
        <VisualState x:Name="Normal">
          <VisualState.Setters>
            <Setter TargetName="ItemsCollectionView"
                    Property="CollectionView.ItemTemplate"
                    Value="{StaticResource PerfItemTemplate}"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Highlighted">
          <VisualState.Setters>
            <Setter TargetName="ItemsCollectionView"
                    Property="CollectionView.ItemTemplate"
                    Value="{StaticResource PerfItemTemplateSelected}"/>
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Selectable">
          <VisualState.Setters>
            <Setter TargetName="ItemsCollectionView"
                    Property="CollectionView.ItemTemplate"
                    Value="{StaticResource PerfItemTemplateSelector}"/>
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateGroupList>
  </VisualStateManager.VisualStateGroups>
  <Grid RowDefinitions="Auto,Auto,Auto,*"
        Padding="8"
        RowSpacing="8">

    <Label Text="Multi Visual Performance"
           FontSize="18"
           FontAttributes="Bold"/>
    <HorizontalStackLayout x:Name="ActionsLayout"
                           Spacing="12"
                           Grid.Row="1">
      <Button Text="Swap Colors"
              Clicked="OnSwapColors"/>
      <Button Text="Change VisualState"
              Clicked="OnChangeVisualState"/>
      <Button Text="Toggle Select All"
              Clicked="OnToggleSelectAll"/>
    </HorizontalStackLayout>
    <BoxView Grid.Row="2"
             HeightRequest="4"
             Color="{DynamicResource Secondary}"/>
    <Grid Grid.Row="3"
          ColumnDefinitions="*,*"
          ColumnSpacing="8">
      <Border Grid.Column="0"
              Padding="8"
              Stroke="{DynamicResource Primary}"
              StrokeThickness="1">
        <Grid x:Name="LeftColumn">
          <CollectionView x:Name="ItemsCollectionView"
                          ItemsSource="{Binding Items}"
                          ItemTemplate="{StaticResource PerfItemTemplate}"/>
          <!-- Lasso overlay -->
          <Grid x:Name="LassoLayer"
                InputTransparent="False">
            <BoxView x:Name="LassoHitSurface"
                     BackgroundColor="Transparent">
              <BoxView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnLassoPan"/>
              </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="LassoRect"
                    IsVisible="False"
                    Stroke="DodgerBlue"
                    StrokeThickness="2"
                    BackgroundColor="#40007ACC"/>
          </Grid>
        </Grid>
      </Border>
      <Border Grid.Column="1"
          x:Name="RightColumn"
              Padding="8"
              Stroke="{DynamicResource Primary}"
              StrokeThickness="1">
        <Grid x:Name="RightPanelGrid"
            RowDefinitions="Auto,Auto,*">
          <Label Text="Panel B"
                 FontAttributes="Bold"/>
          <ctrl:WinUIListViewShim x:Name="RightListShim" Grid.Row="2"
                                  ItemsSource="{Binding Items}"/>
        </Grid>
      </Border>
    </Grid>

  </Grid>

</ContentView>
