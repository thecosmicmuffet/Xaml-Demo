  <!-- Include MAUI assemblies in package after WPF build completes -->
  <Target Name="IncludeMauiAssembliesInPackage" AfterTargets="GetCopyToOutputDirectoryItems">
    <PropertyGroup>
      <_WpfOutDir>..\Xaml.Demo.Host.Wpf\bin\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\</_WpfOutDir>
    </PropertyGroup>
    <ItemGroup>
      <!-- Include MAUI main assembly -->
      <Content Include="$(_WpfOutDir)Xaml Demo.dll" Condition="Exists('$(_WpfOutDir)Xaml Demo.dll')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Xaml.Demo.Host.Wpf\Xaml Demo.dll</TargetPath>
      </Content>
      <!-- Include MAUI framework assemblies -->
      <Content Include="$(_WpfOutDir)Microsoft.Maui.dll" Condition="Exists('$(_WpfOutDir)Microsoft.Maui.dll')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Xaml.Demo.Host.Wpf\Microsoft.Maui.dll</TargetPath>
      </Content>
      <Content Include="$(_WpfOutDir)Microsoft.Maui.Controls.dll" Condition="Exists('$(_WpfOutDir)Microsoft.Maui.Controls.dll')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Xaml.Demo.Host.Wpf\Microsoft.Maui.Controls.dll</TargetPath>
      </Content>
      <Content Include="$(_WpfOutDir)Microsoft.Maui.Essentials.dll" Condition="Exists('$(_WpfOutDir)Microsoft.Maui.Essentials.dll')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>Xaml.Demo.Host.Wpf\Microsoft.Maui.Essentials.dll</TargetPath>
      </Content>
    </ItemGroup>
    <Message Text="Added @(Content->Count()) MAUI files to package content" Importance="high" />
  </Target>
  
