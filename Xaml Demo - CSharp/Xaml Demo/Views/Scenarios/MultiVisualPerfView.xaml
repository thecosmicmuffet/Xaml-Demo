<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Xaml_Demo.ViewModels;assembly=Xaml.Demo.Core"
             xmlns:svc="clr-namespace:Xaml_Demo.Services"
             xmlns:sel="clr-namespace:Xaml_Demo.Views.Selectors"
             xmlns:ctrl="clr-namespace:Xaml_Demo.Controls"
             xmlns:conv="clr-namespace:Xaml_Demo.Converters"
             x:Class="Xaml_Demo.Views.Scenarios.MultiVisualPerfView"
             x:DataType="vm:MultiVisualPerfViewModel"
             Loaded="OnLoaded"
             BindingContext="{StaticResource MultiVisualPerfViewModel}">
  <ContentView.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="PerfItemTemplate"
                    x:DataType="vm:PerfItemViewModel">
        <Grid ColumnDefinitions="40,*"
              Padding="2"
              svc:FirstBindTracker.Enable="True">
          <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped"
                                  CommandParameter="{Binding .}"/>
          </Grid.GestureRecognizers>
          <BoxView Color="{Binding Color}"
                   CornerRadius="4"/>
          <Label Grid.Column="1"
                 Text="{Binding ColorString}"
                 FontSize="12"
                 VerticalTextAlignment="Center"/>
        </Grid>
      </DataTemplate>

      <DataTemplate x:Key="PerfItemTemplateSelected"
                    x:DataType="vm:PerfItemViewModel">
        <Border Padding="8"
                Stroke="{DynamicResource Primary}"
                StrokeThickness="1">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnItemTapped"
                                  CommandParameter="{Binding .}"/>
          </Border.GestureRecognizers>
          <Grid ColumnDefinitions="40,*"
                Padding="2"
                svc:FirstBindTracker.Enable="True">
            <BoxView Color="{Binding Color}"
                     CornerRadius="4"/>
            <Label Grid.Column="1"
                   Text="{Binding ColorString}"
                   FontSize="12"
                   VerticalTextAlignment="Center"/>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- Template selector leveraging selection context (the view model) -->
      <sel:PerfItemSelectionTemplateSelector x:Key="PerfItemTemplateSelector"
                                             PerfItemTemplate="{StaticResource PerfItemTemplate}"
                                             PerfItemTemplateSelected="{StaticResource PerfItemTemplateSelected}"
                                             SelectionContext="{StaticResource MultiVisualPerfViewModel}"/>

      <!-- Converter-driven template swap (Selected bool -> DataTemplate) -->
      <conv:SelectionToTemplateConverter x:Key="PerfItemSelectionByPropConverter"
                                         SelectedTemplate="{StaticResource PerfItemTemplateSelected}"
                                         UnselectedTemplate="{StaticResource PerfItemTemplate}"/>

      <!-- Container template that binds Selected and picks inner template via converter -->
      <DataTemplate x:Key="PerfItemTemplateByProp"
                    x:DataType="vm:PerfItemViewModel">
        <ctrl:TemplateHost Item="{Binding .}"
                           Template="{Binding Selected, Converter={StaticResource PerfItemSelectionByPropConverter}}"/>
      </DataTemplate>
    </ResourceDictionary>
  </ContentView.Resources>

  <!-- Visual states retained (empty) for code-behind driven template switching after dynamic surface mount -->
  <VisualStateManager.VisualStateGroups>
    <VisualStateGroupList>
      <VisualStateGroup x:Name="ColorStates">
        <VisualState x:Name="Normal"/>
        <VisualState x:Name="Highlighted"/>
        <VisualState x:Name="Selectable"/>
        <VisualState x:Name="SelectableByProperty"/>
      </VisualStateGroup>
    </VisualStateGroupList>
  </VisualStateManager.VisualStateGroups>

  <Grid RowDefinitions="Auto,Auto,Auto,*"
        Padding="8"
        RowSpacing="8">

    <Label Text="Multi Visual Performance"
           FontSize="18"
           FontAttributes="Bold"/>

    <Grid Grid.Row="1"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="12"
          VerticalOptions="Center">
      <HorizontalStackLayout x:Name="ActionsLayout"
                             Spacing="12"
                             Grid.Row="1">
        <Button Text="Swap Colors (property updates)"
                Clicked="OnSwapColors"/>
        <Button Text="Change VisualState"
                Clicked="OnChangeVisualState"/>
        <Button Text="Toggle Select All (HashSet membership)"
                Clicked="OnToggleSelectAll"/>
        <Button Text="Toggle Select All (ItemViewModel property)"
                Clicked="OnToggleSelectAllViaPropertyAsync"/>
      </HorizontalStackLayout>
      <Label Grid.Column="1"
             VerticalTextAlignment="Center"
             Text="{Binding CurrentColorState}"/>
    </Grid>

    <BoxView Grid.Row="2"
             HeightRequest="4"
             Color="{DynamicResource Secondary}"/>

    <Grid Grid.Row="3"
          ColumnDefinitions="*,*"
          ColumnSpacing="8">
      <Border Grid.Column="0"
              Padding="8"
              Stroke="{DynamicResource Primary}"
              StrokeThickness="1">
        <Grid x:Name="LeftColumn"
              RowDefinitions="Auto,Auto,*">
          <Label Text="Panel A"
                 FontAttributes="Bold"/>
          <Rectangle Grid.Row="1"
                     HeightRequest="4"
                     Fill="{DynamicResource Secondary}"/>
          <!-- Dynamic surface host (replaces static ItemsCollectionView) -->
          <ContentView x:Name="LeftSurfaceHost"
                       Grid.Row="2"/>
          <!-- Lasso overlay (disabled; to be re-attached after dynamic migration) -->
          <!--
          <Grid x:Name="LassoLayer"
                InputTransparent="True">
            <BoxView x:Name="LassoHitSurface"
                     BackgroundColor="Transparent">
              <BoxView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnLassoPan"/>
              </BoxView.GestureRecognizers>
            </BoxView>
            <Border x:Name="LassoRect"
                    IsVisible="False"
                    Stroke="DodgerBlue"
                    StrokeThickness="2"
                    BackgroundColor="#40007ACC"/>
          </Grid>
          -->
        </Grid>
      </Border>

      <Border Grid.Column="1"
              x:Name="RightColumn"
              Padding="8"
              Stroke="{DynamicResource Primary}"
              StrokeThickness="1">
        <Grid x:Name="RightPanelGrid"
              RowDefinitions="Auto,Auto,*">
          <Label Text="Panel B"
                 FontAttributes="Bold"/>
          <Rectangle Grid.Row="1"
                     HeightRequest="4"
                     Fill="{DynamicResource Secondary}"/>
          <ContentView x:Name="RightSurfaceHost"
                       Grid.Row="2"/>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</ContentView>
